{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://impulsox.ai/schemas/fact-sheet.schema.json",
  "title": "ImpulsoX Fact Sheet",
  "description": "Structured facts extracted from the client's site. Single source of truth for every factual claim in copy. extraction_complete is false until operator approves (Step 0.6).",
  "type": "object",
  "required": ["domain", "scraped_at", "business_name", "prices", "extraction_complete"],
  "additionalProperties": false,
  "properties": {
    "domain": { "type": "string", "minLength": 1 },
    "scraped_at": { "type": "string", "format": "date-time" },
    "business_name": { "type": "string", "minLength": 1 },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "amount_minor", "currency", "covers"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "amount_minor": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
          "covers": { "type": "string", "minLength": 1 }
        }
      }
    },
    "menu_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "open", "close"],
        "additionalProperties": false,
        "properties": {
          "day": { "type": "string" },
          "open": { "type": "string" },
          "close": { "type": "string" }
        }
      }
    },
    "rating": {
      "type": "object",
      "required": ["value", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 5 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "review_count": {
      "type": "object",
      "required": ["value", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "address": { "type": "string" },
    "reservation_method": { "type": "string" },
    "site_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extraction_complete": { "type": "boolean" }
  }
}
