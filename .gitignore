# Segredos — nunca commitar
.env
.env.*
!.env.example
*.token
*-secret*

# Dependências
node_modules/

# Saídas e temporários
.tmp/
producao/**/rascunho-*
*.log

# Dados de cliente real — nunca versionar no produto
.claude/skills/impulsox-chatgpt-ads/deliverables/
.firecrawl-cache/
eskina*

# Obsidian — config local do visualizador do vault, não versiona
.obsidian/

# Sistema
.DS_Store
Thumbs.db
.firecrawl/

# dados/ — uploads, exports, custos e atividade (local, nunca no git)
dados/**
!dados/**/
!**/.gitkeep

# canal-youtube/edicao/<slug>/ — saídas de edição (vídeo é dado real, nunca no git).
# Mantém só os templates de marca e o README.
canal-youtube/edicao/*/
!canal-youtube/edicao/templates/

# gravações de tela (arquivos grandes)
canal-youtube/gravacoes/

# Remotion: assets de produto capturados (carrosséis, screenshots de página) e trilhas.
# Dados pesados/regeneráveis — não versionar. A skill recaptura de producao/ quando precisa.
public/carrosseis/
public/paginas/
public/trilhas/
public/specimen.png

# Mídia pesada (áudio/vídeo) — fica local, não versiona. Reel renderiza do .tsx; trilha
# extrai da gravação. O CÓDIGO (.tsx) versiona; o MP4/áudio não.
*.mp4
*.mov
*.webm
*.m4a
*.aac
*.wav
*.mp3
.claude/settings.local.json
.claude/worktrees/
