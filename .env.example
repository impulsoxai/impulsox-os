# Modelo de variáveis de ambiente do ImpulsoX-OS.
# Copie para .env e preencha o que for usar. O .env real NUNCA é versionado
# (.gitignore já bloqueia). Cada conector é opcional — preencha só o que ativar.

# --- Integração com o ImpulsoX CRM v3 (/roi, /leads, hub — um token por cliente/tenant) ---
# CRM_TOKEN = service token "ixk_live_..." gerado na aba Configurações > Integrações do CRM
# (scope data:read). Escopado a 1 tenant, revogável. NUNCA versionar.
CRM_BASE_URL=
CRM_TOKEN=

# --- Gerar imagem e vídeo por IA (/post Modo 3, reel, vídeo hero da /pagina) ---
# Dois provedores; o gerar-video.mjs alterna com --provedor kie|fal.
# KIE.AI é o PADRÃO recomendado (mais barato; modelos Kling/Seedance/Veo). Pegue a key
# em kie.ai/api-key. Fal.ai é a alternativa. Preencha pelo menos um.
KIE_KEY=
FAL_KEY=

# --- Publicar / medir no Instagram + Facebook (/publicar, /desempenho) ---
IG_USUARIO_ID=
META_PAGINA_ID=
META_TOKEN_PAGINA=

# --- Publicar na página de empresa do LinkedIn (/publicar, /linkedin) ---
LINKEDIN_ORG_ID=
LINKEDIN_TOKEN=

# --- Google Business Profile / Maps (/local) ---
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=

# --- Deploy de páginas/artigos (/pagina, /conteudo) ---
SITE_REPO_DIR=

# --- Edição de vídeo do canal YouTube (/editar-video) — todas opcionais (têm default) ---
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_IDIOMA=
FFMPEG_BIN=

# --- Upload pro YouTube (/publicar, Fase 3) — OAuth; todas opcionais (sem elas = assistido) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
